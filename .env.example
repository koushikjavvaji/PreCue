# Copy this file to .env and fill in your keys. Never commit .env.
DEEPGRAM_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
GROQ_API_KEY=your_key_here

# Optional: LLM settings
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_REQUESTS_PER_MINUTE=15
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BACKUP_MODEL=openai/gpt-oss-120b   (used when GROQ_MODEL hits its free-tier limit; empty = none)
# GROQ_REQUESTS_PER_MINUTE=30
# LIVE_LLM=groq              (or gemini, if you have no Groq key)
# LIVE_GEMINI_BACKUP=on      (off: when both Groq models are limited, skip the check instead of asking Gemini)

# Optional: whispers
# WHISPER_DEVICE=AirPods     (part of your earphones' name; list devices with: python -m sounddevice)
# WHISPER_VOLUME=0.6         (0 to 1)

# Optional: LangSmith tracing (see every LLM call and search at smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_key_here
# LANGSMITH_PROJECT=PreCue
